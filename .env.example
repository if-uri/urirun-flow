# Optional LLM planner configuration. Leave the model empty for offline mode.
# URIRUN_LLM_MODEL=
URIRUN_LLM_MAX_TOKENS=4096
# URIRUN_LLM_API_BASE=

# The heuristic fallback is enabled by default. Set strict mode to 1 to fail
# when the configured LLM planner is unavailable.
URIRUN_STRICT_LLM_PLANNER=0
URIRUN_ALLOW_HEURISTIC_PLANNER_FALLBACK=1

# Provider credentials are intentionally empty in this tracked template.
# OPENROUTER_API_KEY=
